---
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import {type Seminario} from "../../features/Seminarios/models";
import {type Taller} from "../../features/Talleres/models";

interface Props {
    data: Taller | Seminario;
    subtitulo?: string;
    duracion?: string;
    mes?: string;
}

const {
    data,
    subtitulo = data.tipo == "Taller" ? 'Taller' : 'Seminario',
    duracion = "3 días",
    mes = "Noviembre"
} = Astro.props;

const { id, titulo, dias, fecha_inicio, horario, imagen_portada, precio, aprenderas_html,slug } = data;
---
<Layout title={`${titulo} | Inforcap`}>
    <div class="w-full mt-10 p-4">
        <div class="max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-12 mx-auto">

            <div class="w-full aspect-square overflow-hidden rounded-xl shadow-lg bg-gray-50">
                <Image
                        src={imagen_portada}
                        alt={titulo}
                        width={800}
                        height={800}
                        class="w-full h-full object-cover"
                        transition:name=`seminario-taller-${slug}`
                />
            </div>

            <div class="w-full">
                <header>
                    <h2 class="text-base">{subtitulo}</h2>
                    <h1 class="font-petrona text-4xl md:text-5xl text-bordoInforcap leading-tight">{titulo}</h1>
                </header>

                <div class="md:flex my-10">
                    { [
                        { label: 'Mes', val: mes },
                        { label: 'Día', val: dias },
                        { label: 'Fecha', val: fecha_inicio },
                        { label: 'Hora', val: horario }
                    ].map((item) => (
                            <div class="px-6 border-r-2 border-amarilloInforcap">
                                <p class="text-xs text-gris uppercase tracking-tighter">{item.label}</p>
                                <p class="text-xl font-petrona text-bordoInforcap font-bold">{item.val}</p>
                            </div>
                    ))}
                </div>

                <div class="prose prose-slate max-w-none">
                    <p class="text-2xl mb-4 text-bordoInforcap font-bold font-petrona">Aprenderás a elaborar:</p>

                    <div class="text-base text-gris leading-relaxed mb-8 custom-content">
                        {aprenderas_html ? (
                                <div set:html={aprenderas_html} />
                        ) : (
                                <slot />
                        )}

                    </div>
                </div>

                <div class="space-y-6 pt-6 border-t border-gray-50">
                    <p class="text-gris"><strong>Duración:</strong> {duracion}</p>

                    <div class="inline-block bg-naranjaInforcap text-white px-6 py-3 rounded-xl shadow-md">
                        <span class="text-sm uppercase block opacity-80">Inversión</span>
                        <span class="text-2xl font-bold">Gs. {precio}</span>
                    </div>

                    <a
                            href={`https://wa.me/595983350062?text=Me%20interesa%20el%20Seminario%20${encodeURIComponent(titulo)}`}
                            target="_blank"
                            class="flex items-center justify-center gap-3 bg-amarilloInforcap w-full py-4 uppercase hover:bg-naranjaInforcap text-white transition-all font-bold rounded-xl shadow-lg group"
                    >
                        <i class="fa-brands fa-whatsapp text-2xl"></i>
                        INSCRIBIRSE AHORA
                    </a>
                </div>


            </div>

        </div>
        <div class="max-w-7xl mx-auto bg-amarilloInforcap h-auto drop-shadow-xl mt-20 grid grid-cols-1 md:grid-cols-2 rounded-lg pb-10">
            <div class="w-full rounded-l-lg overflow-hidden">
                <h1 class="text-4xl p-10 font-bold text-bordoInforcap">¡No pierdas esta oportunidad! Elige tu carrera, elige un futuro mejor.</h1>
                <img src="https://images.pexels.com/photos/15587528/pexels-photo-15587528/free-photo-of-comida-azucar-postre-dulce.jpeg" class="absolute inset-0 -z-10 h-full w-full object-cover object-right md:object-center">
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    .custom-content ul {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .custom-content li, .custom-content p {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
        list-style: none;
    }

    .custom-content div {
        display: flex;
        flex-direction: column;
    }
</style>
