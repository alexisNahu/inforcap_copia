---
    import {Image} from 'astro:assets'
    import bannerWebDiplomados2025 from '../assets/img/banner-web-diplomados-2025.jpg'
    import bannerWebInforcap2025 from '../assets/img/BANNER-WEB-inforcap-2025.jpg'
    import '../styles/carusel.css'
---
<div class="w-full h-full bg-naranjaInforcap">
    <article>
        <div
                id="carouselExampleControls"
                class="carousel slide"
                data-ride="carousel"
        >
            <div class="carousel-inner">
                <div class="carousel-item py-5 active">
                    <Image src={bannerWebDiplomados2025} alt="Diplomados 2025" class={'d-block object-cover w-screen'}/>
                </div>

                <div class="carousel-item py-5">
                    <Image src={bannerWebInforcap2025} alt="Seminarios y Talleres Abril 2025" class={'d-block object-cover w-screen'} />
                </div>
            </div>

            <a
                    class="carousel-control-prev"
                    href="#carouselExampleControls"
                    role="button"
                    data-slide="prev"
            >
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a
                    class="carousel-control-next"
                    href="#carouselExampleControls"
                    role="button"
                    data-slide="next"
            >
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </article>
</div>
