---
import { Image } from 'astro:assets';

// Importación de iconos (Ajusta las rutas según tu estructura de carpetas)
import iconPanaderia from '../assets/img/icon-panaderia.png';
import iconReposteria from '../assets/img/icon-reposteria.png';
import iconHeladeria from '../assets/img/icon-heladeria.png';
import iconConfiteria from '../assets/img/icon-confiteria.png';
import iconPasteleria from '../assets/img/icon-pasteleria.png';
import {APP_PAGES} from '../constants'
---

<div class="text-center py-8 px-6">
    <h1 class="text-6xl font-bold tracking-tight font-sacramento text-bordoInforcap">Cursos disponibles</h1>
    <h3 class="text-base tracking-tight text-gris">
        Nuestros talleres y seminarios están enfocados a impartir clases 1 vez a la semana. <br />
        Descubre las mejores técnicas de la más deliciosa profesión.
    </h3>
</div>

<div class="w-56 md:container mx-auto grid grid-cols-1 md:grid-cols-5 md:max-w-7xl items-center place-content-center gap-4">
    <a href=`${APP_PAGES.carrera_tecnica_panaderia_y_confiteria}` class="w-48 md:w-56 mx-auto">
        <Image src={iconPanaderia} alt="Icono Panadería" />
    </a>
    <a href=`${APP_PAGES.especializacion_pasteleria_y_confiteria}` class="w-48 md:w-56 mx-auto">
        <Image src={iconReposteria} alt="Icono Repostería" />
    </a>
    <a href={APP_PAGES.especializacion_pasteleria_y_confiteria} class="w-48 md:w-56 mx-auto">
        <Image src={iconHeladeria} alt="Icono Heladería" />
    </a>
    <a href={APP_PAGES.carrera_tecnica_panaderia_y_confiteria} class="w-48 md:w-56 mx-auto">
        <Image src={iconConfiteria} alt="Icono Confitería" />
    </a>
    <a href={APP_PAGES.especializacion_decoracion_de_tortas} class="w-48 md:w-56 mx-auto">
        <Image src={iconPasteleria} alt="Icono Pastelería" />
    </a>
</div>

<div class="md:w-full bg-[url('../assets/img/bg-newsletter.png')] bg-cover bg-center my-20 px-8">
    <div class="container mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-2 items-center place-content-center py-40">
        <div class="mb-8 md:mb-0">
            <h1 class="text-3xl text-white font-petrona">¿Te interesa uno de nuestros cursos?</h1>
            <p class="text-white">Suscribite a nuestro Boletín y te enviamos mensualmente nuestros cursos habilitados</p>
        </div>

        <div class="h-20 md:flex mx-auto">
            <div class="mr-2">
                <input type="email" name="email" id="email" placeholder="Correo Electrónico" autocomplete="email" class="bg-white block w-80 md:w-96 rounded-md border-0 px-2.5 py-2.5 text-gris shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gris focus:ring-2 focus:ring-inset focus:ring-bordoInforcap sm:text-sm sm:leading-6">
            </div>
            <div class="mt-4 md:mt-0">
                <button type="submit" class="block w-4/6 md:w-full rounded-md bg-bordoInforcap px-5 py-2.5 text-center text-base text-white shadow-sm hover:bg-amarilloInforcap hover:text-bordoInforcap transition-colors">Inscribite</button>
            </div>
        </div>
    </div>
</div>
