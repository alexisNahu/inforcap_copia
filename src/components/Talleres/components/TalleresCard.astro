---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    image: ImageMetadata;
    alt: string;
    titulo: string;
    precio: string;
    diaSemana: string;
    fecha: string;
    horario: string;
    hrefVerMas: string;
    textoWhatsapp: string;
}

const {
    image,
    alt,
    titulo,
    precio,
    diaSemana,
    fecha,
    horario,
    hrefVerMas,
    textoWhatsapp
} = Astro.props;

const whatsappLink = `https://wa.me/595983350062?text=${encodeURIComponent(textoWhatsapp)}`;
---

<div class="w-4/5 md:w-full h-full flex flex-col justify-between rounded-lg mx-auto overflow-hidden drop-shadow-md bg-white">
    <Image src={image} alt={alt} class="w-full h-48 object-cover" />

    <div class="font-petrona px-4 mt-4">
        <div class="text-base uppercase text-grisClaro font-body">TALLER</div>
        <div class="text-3xl uppercase">{titulo}</div>
        <div class="text-2xl text-naranjaInforcap">{precio}</div>
    </div>

    <div class="px-4 py-4">
        <div class="text-base text-gris">
            <i class="fa-solid fa-arrow-right text-grisClaro mr-2"></i>{diaSemana}
        </div>
        <div class="text-base text-gris">
            <i class="fa-solid fa-calendar-days text-grisClaro mr-2"></i>{fecha}
        </div>
        <div class="text-base text-gris">
            <i class="fa-solid fa-clock text-grisClaro mr-2"></i>{horario}
        </div>
        <div class="underline mt-4 text-naranjaInforcap space-x-2">
            <i class="fa-solid fa-arrow-right"></i>
            <a href={hrefVerMas}>Ver más</a>
        </div>
    </div>

    <button class="bg-naranjaInforcap w-full py-4 uppercase hover:bg-amarilloInforcap text-white flex justify-center items-center">
        <span class="mr-2"><i class="fa-brands fa-whatsapp"></i></span>
        <a href={whatsappLink} target="_blank">INSCRIBIRSE</a>
    </button>
</div>
