---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    image: ImageMetadata;
    imageAlt: string;
    mes: string;
    dia: string;
    fecha: string;
    hora: string;
    temario: string[];
    costo: string;
    nota?: string;
    fraseGancho: string;
}

const { title, image, imageAlt, mes, dia, fecha, hora, temario, costo, nota, fraseGancho } = Astro.props;
---

<section class="w-full mt-10 p-4">
    <div class="max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-12 mx-auto items-center">
        <div class="w-full aspect-square max-w-[500px] mx-auto">
            <Image src={image} alt={imageAlt} class="w-full h-full object-cover rounded-2xl shadow-2xl" />
        </div>

        <div class="w-full">
            <header>
                <p class="text-bordoInforcap font-bold uppercase tracking-widest text-sm mb-2 text-center md:text-left">Taller práctico de 1 día</p>
                <h1 class="font-petrona text-4xl md:text-5xl text-bordoInforcap leading-tight text-center md:text-left uppercase" set:html={title}></h1>
            </header>

            <div class="grid grid-cols-2 md:grid-cols-4 my-10 gap-4">
                {[
                    { label: "Mes", value: mes },
                    { label: "Día", value: dia },
                    { label: "Fecha", value: fecha },
                    { label: "Hora", value: hora }
                ].map((item) => (
                        <div class="px-4 border-l-4 border-amarilloInforcap">
                            <p class="text-xs uppercase tracking-widest text-gris font-bold">{item.label}</p>
                            <p class="text-xl font-petrona text-bordoInforcap font-bold">{item.value}</p>
                        </div>
                ))}
            </div>

            <div class="space-y-6">
                <h2 class="text-2xl text-bordoInforcap font-bold italic">Aprenderás a elaborar:</h2>
                <ul class="space-y-3">
                    {temario.map((item) => (
                            <li class="flex items-center text-gris leading-relaxed">
                                <span class="text-amarilloInforcap mr-3 font-bold text-xl">→</span> {item}
                            </li>
                    ))}
                </ul>
            </div>

            <div class="mt-10 p-6 bg-slate-50 rounded-xl inline-block border border-slate-200 shadow-sm">
                {nota && (
                        <p class="text-gris mb-2 font-bold italic border-b border-slate-200 pb-2">
                            {nota}
                        </p>
                )}
                <div class="text-3xl font-bold text-white bg-naranjaInforcap px-6 py-3 rounded-lg shadow-lg">
                    Costo: {costo}
                </div>
            </div>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto bg-amarilloInforcap mt-24 rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
    <div class="p-12 md:w-2/3 flex items-center">
        <h2 class="text-4xl md:text-5xl font-bold text-bordoInforcap leading-tight font-petrona" set:html={fraseGancho}></h2>
    </div>
    <div class="md:w-1/3 h-64 md:h-auto relative">
        <img src="https://images.pexels.com/photos/15587528/pexels-photo-15587528/free-photo-of-comida-azucar-postre-dulce.jpeg" class="absolute inset-0 w-full h-full object-cover" />
    </div>
</section>
