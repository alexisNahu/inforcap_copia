---

<section>
    <div class="text-center py-8 px-8">
        <h1 class="text-3xl font-bold tracking-tight font-petrona">Talleres</h1>
        <h2 class="text-6xl font-bold tracking-tight text-bordoInforcap font-petrona">Noviembre 2025</h2>
        <h3 class="text-base tracking-tight text-gris">
            Nuestros talleres están enfocados a impartir clases de un día. <br />
            <strong>¡Descubre las mejores técnicas de la más deliciosa profesión!</strong>
        </h3>
    </div>

    <div class="container mx-auto my-8 max-w-7xl grid grid-cols-1 md:grid-cols-4 gap-8">
        {listaTalleres.map((taller) => (
                <TalleresCard
                        image={taller.image}
                        alt={taller.titulo}
                        titulo={taller.titulo}
                        precio={taller.precio}
                        diaSemana={taller.diaSemana}
                        fecha={taller.fecha}
                        horario={taller.horario}
                        hrefVerMas={taller.hrefVerMas}
                        textoWhatsapp={taller.textoWhatsapp}
                />
        ))}
    </div>
</section>
