---
import {Image} from "astro:assets";
import {type ImageMetadata} from "astro";

interface Props {
    titulo: string,
    precio: string,
    img: {
        src: ImageMetadata,
        alt: string
    },
    horario: {
        dia: string,
        fecha: string,
        hora: string,
    },
    verMasHref: string
}

const {titulo, precio, img, horario, verMasHref} = Astro.props
---

<div class="w-4/5 md:w-full h-full flex flex-col justify-between rounded-lg mx-auto overflow-hidden drop-shadow-md bg-white object-cover">

    <Image src={img.src} alt={img.alt} />
    <div class="font-petrona px-4 mt-4">
        <div class="text-base uppercase text-grisClaro font-body">SEMINARIO</div>
        <div class="text-3xl">{titulo}</div>
        <div class="text-2xl text-naranjaInforcap">{precio}</div>
    </div>

    <div class="px-4 py-4">
        <div class="text-base text-gris"><i class="fa-solid fa-arrow-right text-grisClaro mr-2"></i>{horario.dia}</div>
        <div class="text-base text-gris"><i class="fa-solid fa-calendar-days text-grisClaro mr-2"></i>{horario.fecha}</div>
        <div class="text-base text-gris"><i class="fa-solid fa-clock text-grisClaro mr-2"></i>{horario.hora}</div>
        <div class="underline mt-4 text-naranjaInforcap space-x-2"><i class="fa-solid fa-arrow-right"></i><a href={verMasHref}>Ver más</a></div>
    </div>

    <button class="bg-naranjaInforcap w-full py-4 uppercase hover:bg-amarilloInforcap text-white space-x-2">
        <span class="w-32"><i class="fa-brands fa-whatsapp"></i></span><a href="https://wa.me/595983350062?text=Me%20interesa%20el%20Seminario%20Heladeria-Industrial">INSCRIBIRSE</a></button>
</div>
