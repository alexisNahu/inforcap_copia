---
import SeminarioCard from './components/SeminarioCard.astro';

import imgHeladeria from '@/assets/img/Heladeria-Industrial.jpg';
import imgAbcReposteria from '@/assets/img/ABC-de-la-reposteria.jpg';
import {APP_PAGES} from "../../constants";

const seminarios = [
    {
        titulo: 'SEMINARIO DE "HELADERIA INDUSTRIAL"',
        precio: "Gs. 430.000",
        img: {
            src: imgHeladeria,
            alt: "Clase de Heladería Industrial"
        },
        horario: {
            dia: "Sábados",
            fecha: "09-23-30 de Noviembre",
            hora: "08:00 a 12:00"
        },
        verMasHref: APP_PAGES.seminario_heladeria_industrial
    },
    {
        titulo: 'SEMINARIO "ABC DE LA REPOSTERÍA"',
        precio: "Gs. 430.000",
        img: {
            src: imgAbcReposteria,
            alt: "Clase de ABC de la Repostería"
        },
        horario: {
            dia: "Sábados",
            fecha: "09-23-30 de Noviembre",
            hora: "08:00 a 12:00"
        },
        verMasHref: APP_PAGES.seminario_abc_reposteria
    }
];
---
    <section class="py-12">
        <div class="text-center py-8 px-8">
            <h1 class="text-3xl font-bold tracking-tight font-petrona">Seminarios</h1>
            <h2 class="text-6xl font-bold tracking-tight text-bordoInforcap font-petrona">Noviembre 2025</h2>
            <h3 class="text-base tracking-tight text-gris">
                Nuestros Seminarios están enfocados a impartir clases tres días al mes.
            </h3>
        </div>

        <div class="container mx-auto my-8 max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-8">
            {seminarios.map((semi) => (
                    <SeminarioCard
                            titulo={semi.titulo}
                            precio={semi.precio}
                            img={semi.img}
                            horario={semi.horario}
                            verMasHref={semi.verMasHref}
                    />
            ))}
        </div>
    </section>
