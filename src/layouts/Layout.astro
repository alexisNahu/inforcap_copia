---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import "../styles/global.css";
import Cursos from "../components/Cursos.astro";
import Auspiciantes from "../components/Auspiciantes.astro";

interface Props {
	title?: string;
}
const { title = "Inforcap" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>

	<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CJ6HQW36LY"></script>
	<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-CJ6HQW36LY');
	</script>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Petrona:wght@400;700&family=Sacramento&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.0/css/all.min.css" />
</head>
<body class="font-body">

<Nav />
<main>
	<slot />
</main>
<Cursos />
<Auspiciantes />
<Footer />

<script is:inline src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
<script is:inline src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js"></script>

<script is:inline src="/js/functions.min.js"></script>
</body>
</html>
