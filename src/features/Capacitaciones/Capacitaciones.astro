---
import reposteriayDecoracion from '@/assets/img/reposteria-y-decoracion.jpeg';
import pasteleriayConfiteria from '@/assets/img/pasteleria-y-confiteria.jpeg';
import panaderiayConfiteria from '@/assets/img/panaderia-y-confiteria.jpeg';
import CapacitacionCard from "./components/CapacitacionCard.astro";
---
<div class="bg-bordoInforcap py-8 md:py-20 px-6">
    <div class="container mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-3 gap-10">

        <CapacitacionCard
                image={{src: reposteriayDecoracion, alt: "Repostería y Decoración Inforcap"}}
                textoWhatsapp="https://wa.me/595983350062?text=Me%20interesa%20el%20Diplomado%20en%20Reposteria%20y%20Decoracion"
        />

        <CapacitacionCard
                image={{src: pasteleriayConfiteria, alt: "Pastelería y Confitería Inforcap"}}
                textoWhatsapp="https://wa.me/595983350062?text=Me%20interesa%20el%20Diplomado%20en%20Pasteleria%20y%20Confiteria"
        />

        <CapacitacionCard
                image={{src: panaderiayConfiteria, alt: "Panadería y Confitería Inforcap"}}
                textoWhatsapp="https://wa.me/595983350062?text=Me%20interesa%20el%20Diplomado%20en%20Panaderia%20y%20Confiteria"
        />
    </div>
</div>
