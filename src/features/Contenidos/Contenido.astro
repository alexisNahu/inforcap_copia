---

import {APP_PAGES} from "@/core/pages";
import {type Seminario} from "./Seminarios/models";
import {type ContenidoDetalle, type Contenidos} from "./models";
import {capitalize} from "@/utils";
import {type Taller} from "./Talleres/models";
import ContenidosCard from "./Components/ContenidosCard.astro";

interface Props {
    contenido: ContenidoDetalle;
    data: Seminario[] | Taller[];
}

const {contenido, data} = Astro.props;


---
<section data-animate class="anim-hidden from-top">
    <div class="text-center py-8 px-8">
        <h1 class="text-3xl font-bold tracking-tight font-petrona">{capitalize(contenido.clave)}</h1>
        <h2 class="text-6xl font-bold tracking-tight text-bordoInforcap font-petrona">{contenido.titulo}</h2>
        <h3 class="text-base tracking-tight text-gris">
            {contenido.descripcion}
        </h3>
    </div>

    <div class="container mx-auto my-8 max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-8">
        {data.map((d) => (
                <ContenidosCard data={d} verMasHref={APP_PAGES.contenido(d.slug)}/>
                <!--<SeminarioCard seminario={semi} verMasHref={APP_PAGES.seminarios(semi.slug)} />-->
        ))}
    </div>
</section>
