---
import {APP_PAGES} from "@/core/pages";
import {type Seminario} from "./Seminarios/models";
import {type ContenidoDetalle, type ContenidosData} from "./models";
import {capitalize} from "@/utils";
import {type Taller} from "./Talleres/models";
import ContenidosCard from "./Components/ContenidosCard.astro";

/*interface Props {
    contenido: ContenidoDetalle;
    data: Seminario[] | Taller[];
    bg_color?: string;
}*/

interface Props<T> {
    info: {data: ContenidosData, content: T[]}
    bg_color?: string;
    esTaller?: boolean;
}

const {info, bg_color} = Astro.props;
---
<!--
    Cambiamos la clase dinámica por style={...}
    Mantenemos las clases de animación y padding intactas.
-->
<section
        data-animate
        class="anim-hidden from-bottom py-12"
        style={{ backgroundColor: bg_color ? bg_color : 'transparent' }}
>
    <div class="text-center mb-12 px-8">
        <h1 class="text-[44px] leading-none tracking-tight font-petrona uppercase text-black font-bold mb-1">
            {info.data.clave}
        </h1>
        <h2 class="text-[44px] leading-tight font-bold tracking-tight text-bordoInforcap font-petrona mb-4">
            {info.data.titulo}
        </h2>
        <h3
                class="text-[20px] leading-normal max-w-2xl mx-auto text-slate-600"
                set:html={info.data.descripcion}
        />
    </div>

    <div class="container mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 justify-items-center items-start">
        {info.content.map((d: any) => (
                <div class="w-full flex justify-center">
                    <ContenidosCard data={d} verMasHref={APP_PAGES.contenido(d.slug)}/>
                </div>
        ))}
    </div>
</section>
