---
import SeminarioCard from './components/SeminarioCard.astro';

import {APP_PAGES} from "../../../core/pages";
import {type Seminario} from "./models";
import {SeminarioService} from "./services";
import {type Contenidos} from "../models";
import {ContenidosServices} from "../services";

const seminarios: Seminario[] = await SeminarioService.getAll()
const contenido: Contenidos = await ContenidosServices.get()
---
    <section data-animate class="anim-hidden from-top">
        <div class="text-center py-8 px-8">
            <h1 class="text-3xl font-bold tracking-tight font-petrona">{contenido.seminarios.clave}</h1>
            <h2 class="text-6xl font-bold tracking-tight text-bordoInforcap font-petrona">{contenido.seminarios.titulo}</h2>
            <h3 class="text-base tracking-tight text-gris">
                {contenido.seminarios.descripcion}
            </h3>
        </div>

        <div class="container mx-auto my-8 max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-8">
            {seminarios.map((semi) => (
                <SeminarioCard seminario={semi} verMasHref={APP_PAGES.seminarios(semi.slug)} />
            ))}
        </div>
    </section>
