---
import { type Seminario } from "../Seminarios/models";
import { Image } from 'astro:assets'
import { type Taller } from "../Talleres/models";
import { APP_PAGES } from "@/core/pages";
import {remoteImageSrc} from "../../../utils"; // Asegúrate de importar APP_PAGES

interface Props {
    data: Seminario | Taller
    verMasHref: string
}

const { data } = Astro.props; // verMasHref ya no es estrictamente necesario si usamos APP_PAGES

const esTaller = data.tipo === 'Seminario';
const colorBoton = esTaller ? "#FFC700" : "#FF8A00";
const detalleHref = APP_PAGES.contenido(data.slug);

---

<div class="w-full flex flex-col h-full min-h-[650px] bg-white rounded-md overflow-hidden shadow-lg transition-transform hover:scale-[1.01] duration-300 border border-slate-100">

    <!-- 1. Envolvemos Imagen e Info en un contenedor que use todo el espacio menos el botón -->
    <div class="flex flex-col flex-grow">

        <!-- Imagen: Usamos basis-1/2 para que ocupe el 50% de este sub-contenedor -->
        <a href={detalleHref} class="h-[260px] shrink-0 overflow-hidden border-b-[3px] border-slate-400/30 block">
            <Image
                    src={data.imagen_portada ?? remoteImageSrc}
                    alt={data.titulo}
                    width={400}
                    height={325}
                    class="w-full h-full object-cover"
                    transition:name={data.slug}
            />
        </a>

        <!-- Información: altura fija de imagen arriba, esta sección ocupa el resto -->
        <div class="flex-1 flex flex-col pt-4 font-petrona w-full justify-start px-6 pb-4">
           <span class="text-[16px] uppercase text-[#A6A6A6] font-body mb-1 block">
                {esTaller ? 'Seminario' : 'CLASES DE UN DÍA'}
            </span>

            <a href={detalleHref} class="block hover:text-bordoInforcap transition-colors">
                <h3 class="font-petrona text-[33px] leading-[1.2] mb-2 line-clamp-2 h-[80px] flex items-start">
                    {data.titulo}
                </h3>
            </a>

            <div class="text-[27px] font-body text-naranjaInforcap mb-4">
                Gs. {data.precio}
            </div>

            <div class="flex flex-col gap-y-2 text-[20px] font-petrona my-auto">
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-circle-dot text-slate-300 text-sm"></i>
                    <span>{data.dias}</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-calendar text-slate-300 text-sm"></i>
                    <span>{data.fecha_inicio}</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-clock text-slate-300 text-sm"></i>
                    <span>{data.horario}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Botón: Queda fuera del flujo de los "basis-1/2", por lo que se cuenta aparte -->
    <a
            href={`https://wa.me/595983350062?text=Me%20interesa%20el%20curso:%20${data.titulo}`}
            target="_blank"
            style={{ backgroundColor: colorBoton }}
            class="w-full py-2 text-center font-body text-white text-[20px] uppercase transition-opacity hover:opacity-90 flex justify-center items-center shrink-0"
    >
        <span>INSCRIBIRSE</span>
    </a>
</div>
