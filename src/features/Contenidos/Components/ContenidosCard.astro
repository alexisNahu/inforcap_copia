---
import { type Seminario } from "../Seminarios/models";
import { Image } from 'astro:assets'
import { type Taller } from "../Talleres/models";
import { APP_PAGES } from "@/core/pages"; // Asegúrate de importar APP_PAGES

interface Props {
    data: Seminario | Taller
    verMasHref: string
}

const { data } = Astro.props; // verMasHref ya no es estrictamente necesario si usamos APP_PAGES

const esTaller = data.tipo === 'Seminario';
const colorBoton = esTaller ? "#FFC700" : "#FF8A00";
// Generamos la URL usando tu función de rutas
const detalleHref = APP_PAGES.contenido(data.slug);
---

<div class="flex flex-col h-full min-h-[620px] bg-white rounded-md overflow-hidden shadow-lg transition-transform hover:scale-[1.01] duration-300 border border-slate-100">

    <!-- Contenedor de Imagen con link -->
    <a href={detalleHref} class="h-[310px] shrink-0 overflow-hidden border-b-[3px] border-slate-400/30 block">
        <Image
                src={data.imagen_portada}
                alt={data.titulo}
                width={400}
                height={310}
                class="w-full h-full object-cover"
                transition:name={data.slug}
        />
    </a>

    <!-- Contenedor de Información -->
    <div class="flex flex-col flex-grow pt-6 font-petrona w-full justify-between">
        <div class="px-6 mb-4">
            <span class="text-[16px] uppercase text-[#A6A6A6] font-body mb-1 block">
                {esTaller ? 'Seminario' : 'CLASES DE UN DÍA'}
            </span>

            {/* El Título ahora es un link a la página de detalle */}
            <a href={detalleHref} class="block hover:text-bordoInforcap transition-colors">
                <h3 class="font-petrona text-[33px] mb-2 line-clamp-2 min-h-[100px]">
                    {data.titulo}
                </h3>
            </a>

            <div class="text-[27px] font-body text-naranjaInforcap mb-6">
                Gs. {data.precio}
            </div>

            <div class="flex flex-col gap-y-3 text-[20px] font-petrona">
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-circle-dot text-slate-300 text-sm"></i>
                    <span>{data.dias}</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-calendar text-slate-300 text-sm"></i>
                    <span>{data.fecha_inicio}</span>
                </div>
                <div class="flex items-center gap-3">
                    <i class="fa-regular fa-clock text-slate-300 text-sm"></i>
                    <span>{data.horario}</span>
                </div>
            </div>
        </div>

        {/* Botón de inscripción a WhatsApp se mantiene igual */}
        <a
                href={`https://wa.me/595983350062?text=Me%20interesa%20el%20curso:%20${data.titulo}`}
                target="_blank"
                style={{ backgroundColor: colorBoton }}
                class="w-full py-4 text-center font-body text-white text-[20px] uppercase transition-opacity hover:opacity-90 flex justify-center items-center mt-auto"
        >
            <span>INSCRIBIRSE</span>
        </a>
    </div>
</div>
