---
import {type Seminario} from "../Seminarios/models";
import {Image} from 'astro:assets'
import {type Taller} from "../Talleres/models";

import notfoundimage from '@/assets/img/notfoundimage.jpg'

interface Props {
    data: Seminario | Taller
    verMasHref: string
}
const {data, verMasHref} = Astro.props

---
<div class="w-4/5 md:w-full h-full flex flex-col justify-between rounded-lg mx-auto overflow-hidden drop-shadow-md bg-white object-cover">

    <Image
            src={data.imagen_portada ? data.imagen_portada : notfoundimage.src}
            alt={data.titulo}
            width={720}
            height={480}
            loading="lazy"
            transition:name=`${data.slug}`
    />
    <div class="font-petrona px-4 mt-4">
        <div class="text-base uppercase text-grisClaro font-body">SEMINARIO</div>
        <div class="text-3xl">{data.titulo}</div>
        <div class="text-2xl text-naranjaInforcap">Gs. {data.precio}</div>
    </div>

    <div class="px-4 py-4">
        <div class="text-base text-gris"><i class="fa-solid fa-arrow-right text-grisClaro mr-2"></i>{data.dias}</div>
        <div class="text-base text-gris"><i class="fa-solid fa-calendar-days text-grisClaro mr-2"></i>{data.fecha_inicio}</div>
        <div class="text-base text-gris"><i class="fa-solid fa-clock text-grisClaro mr-2"></i>{data.horario}</div>
        <div class="underline mt-4 text-naranjaInforcap space-x-2"><i class="fa-solid fa-arrow-right"></i><a href={verMasHref}>Ver más</a></div>
    </div>

    <button class="bg-naranjaInforcap w-full py-4 uppercase hover:bg-amarilloInforcap text-white space-x-2">
        <span class="w-32"><i class="fa-brands fa-whatsapp"></i></span><a href="https://wa.me/595983350062?text=Me%20interesa%20el%20Seminario%20Heladeria-Industrial">INSCRIBIRSE</a></button>
</div>
