---
export const prerender = false;
import '@/styles/carusel.css'
import {Image} from 'astro:assets'
import {type Banner} from "./models";
import {BannerService} from "./services";

const banners: Banner[] = await BannerService.getAll()
const banners_ordenados = banners.sort((a,b) => a.orden - b.orden)
---
<div data-animate class="anim-hidden w-full">
    <article>
        <!-- Cambiado data-ride por data-bs-ride -->
        <div
                id="carouselExampleControls"
                class="carousel slide"
                data-bs-ride="carousel"
        >
            <div class="carousel-inner">
                {banners_ordenados.map((ban, i) => (
                        <div class={`carousel-item ${i === 0 ? 'active' : ''}`}>
                            <Image
                                    src={ban.imagen}
                                    alt={ban.descripcion}
                                    class="w-full h-auto min-h-[180px] md:h-[550px] object-cover"
                                    width={1920}
                                    height={1080}
                                    loading={i === 0 ? "eager" : "lazy"}
                            />
                        </div>
                ))}
            </div>

            <!-- Botones corregidos con data-bs-target y data-bs-slide -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </button>
        </div>
    </article>
</div>
