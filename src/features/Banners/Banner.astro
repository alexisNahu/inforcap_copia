---
    import {Image} from 'astro:assets'
    import bannerWebDiplomados2025 from '@/assets/img/banner-web-diplomados-2025.jpg'
    import bannerWebInforcap2025 from '@/assets/img/BANNER-WEB-inforcap-2025.jpg'
    import '@/styles/carusel.css'
    import {type Banner} from "./models";
    import {BannerService} from "./services";

    const banners: Banner[] = await BannerService.getAll()
    const banners_ordenados = banners.sort((a,b) => a.orden - b.orden)
---
<div class="w-full h-full bg-naranjaInforcap">
    <article>
        <div
                id="carouselExampleControls"
                class="carousel slide"
                data-ride="carousel"
        >
            <div class="carousel-inner">
                {banners_ordenados.map((ban, i) => (
                    <div class=`carousel-item py-5 ${i === 0 ? 'active' : ''}`>
                        <Image src={ban.imagen}
                               alt={ban.descripcion}
                               class={'d-block object-cover w-screen'}
                               width={19200}
                               height={8000}/>
                    </div>
                ))}
            </div>

            <a
                    class="carousel-control-prev"
                    href="#carouselExampleControls"
                    role="button"
                    data-slide="prev"
            >
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a
                    class="carousel-control-next"
                    href="#carouselExampleControls"
                    role="button"
                    data-slide="next"
            >
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </article>
</div>
