---
import logoInforcap from '../assets/img/logo-inforcap.png'
import {Image} from 'astro:assets'
import {APP_PAGES} from "../core/pages";
---
<nav class="relative w-full">
    <div class="container mx-auto p-6 max-w-7xl flex items-center justify-between">
        <!-- Logo a la izquierda -->
        <div>
            <a href="/">
                <Image src={logoInforcap} alt="Logo de Inforcap" class="w-48"/>
            </a>
        </div>

        <!-- Menú a la derecha -->
        <div class="hidden md:flex items-center space-x-8 uppercase font-body text-[20px] text-black">
            <a href={APP_PAGES.inforcap} class="hover:text-bordoInforcap transition-colors">Inforcap</a>
            <a href={APP_PAGES.formacion_profesional} class="hover:text-bordoInforcap transition-colors">Formación profesional</a>
            <a href="#" class="hover:text-bordoInforcap transition-colors">Actividades</a>
            <a href={APP_PAGES.videos} class="hover:text-bordoInforcap transition-colors">Videos</a>
            <a href="#" class="hover:text-bordoInforcap transition-colors">RSE</a>
            <a href="#contactenos" class="hover:text-bordoInforcap transition-colors">Contacto</a>

            <!-- Redes -->
            <div class="flex gap-4 items-center pl-4">
                <a href="https://www.facebook.com/Inforcap.edu.py" target="_blank"
                   class="flex items-center justify-center w-10 h-10 rounded-full bg-bordoInforcap text-white text-xl transition-transform hover:scale-110">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="https://www.instagram.com/inforcap.edu.py/" target="_blank"
                   class="flex items-center justify-center w-10 h-10 rounded-full bg-bordoInforcap text-white text-xl transition-transform hover:scale-110">
                    <i class="fa-brands fa-instagram"></i>
                </a>
            </div>
        </div>

    </div>
</nav>
