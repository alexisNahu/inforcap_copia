---
import logoInforcap from '../assets/img/logo-inforcap.png'
import { Image } from 'astro:assets'
import { APP_PAGES } from "../core/pages";
---

<nav class="relative w-full bg-white z-50">
    <div class="flex items-center justify-between w-full p-4 md:py-8 lg:px-16">

        <div class="shrink-0 z-50">
            <a href="/">
                <Image src={logoInforcap} alt="Logo de Inforcap" class="w-28 sm:w-32 md:w-40 lg:w-48 transition-all"/>
            </a>
        </div>

        <button id="menu-btn" class="z-50 block md:hidden focus:outline-none p-2 w-10 h-10 relative">
            <span class="hamburger-top w-8 h-0.5 bg-black block absolute left-1 top-3 transition-all duration-300"></span>
            <span class="hamburger-middle w-8 h-0.5 bg-black block absolute left-1 top-5 transition-all duration-300"></span>
            <span class="hamburger-bottom w-8 h-0.5 bg-black block absolute left-1 top-7 transition-all duration-300"></span>
        </button>

        <div id="menu" class="absolute top-0 left-0 flex flex-col items-center justify-center w-full h-screen space-y-8 bg-white uppercase font-body text-[20px] md:static md:h-auto md:py-0 md:flex md:flex-row md:w-auto md:space-y-0 md:space-x-4 lg:space-x-8 md:bg-transparent md:text-[15px] lg:text-[20px] text-black transition-all duration-300 mobile-menu">

            <a href={APP_PAGES.inforcap} class="hover:text-bordoInforcap transition-colors whitespace-nowrap">Inforcap</a>
            <a href={APP_PAGES.formacion_profesional} class="hover:text-bordoInforcap transition-colors whitespace-nowrap">Formación profesional</a>
            <a href="#" class="hover:text-bordoInforcap transition-colors whitespace-nowrap">Actividades</a>
            <a href={APP_PAGES.videos} class="hover:text-bordoInforcap transition-colors whitespace-nowrap">Videos</a>
            <a href="#" class="hover:text-bordoInforcap transition-colors whitespace-nowrap">RSE</a>
            <a href="#contactenos" class="hover:text-bordoInforcap transition-colors whitespace-nowrap">Contacto</a>

            <div class="flex gap-4 items-center pt-4 md:pt-0 md:pl-2 lg:pl-4">
                <a href="https://www.facebook.com/Inforcap.edu.py" target="_blank"
                   class="flex items-center justify-center w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-bordoInforcap text-white text-lg lg:text-xl transition-transform hover:scale-110">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="https://www.instagram.com/inforcap.edu.py/" target="_blank"
                   class="flex items-center justify-center w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-bordoInforcap text-white text-lg lg:text-xl transition-transform hover:scale-110">
                    <i class="fa-brands fa-instagram"></i>
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    // Usamos una función para inicializar que funcione incluso si usas transiciones de página de Astro
    const initMenu = () => {
        const btn = document.getElementById('menu-btn');
        const nav = document.getElementById('menu');

        if (!btn || !nav) return;

        // Limpiamos listeners previos por si acaso
        btn.replaceWith(btn.cloneNode(true));
        const newBtn = document.getElementById('menu-btn');

        newBtn?.addEventListener('click', () => {
            nav.classList.toggle('open');
            newBtn.classList.toggle('open');
            document.body.classList.toggle('overflow-hidden');
        });

        const links = nav.querySelectorAll('a');
        links.forEach(link => {
            link.addEventListener('click', () => {
                nav.classList.remove('open');
                newBtn?.classList.remove('open');
                document.body.classList.remove('overflow-hidden');
            });
        });
    };

    // Corre en la carga inicial
    initMenu();
    // Corre si usas Astro View Transitions
    document.addEventListener('astro:page-load', initMenu);
</script>

<style>
    .mobile-menu {
        display: none;
    }

    .mobile-menu.open {
        display: flex;
    }

    @media (min-width: 768px) {
        .mobile-menu {
            display: flex !important;
        }
    }

    .whitespace-nowrap {
        white-space: nowrap;
    }
</style>

<style is:global>
    #menu-btn.open .hamburger-top {
        top: 20px !important;
        transform: rotate(45deg);
    }
    #menu-btn.open .hamburger-middle {
        opacity: 0;
    }
    #menu-btn.open .hamburger-bottom {
        top: 20px !important;
        transform: rotate(-45deg);
    }
</style>
