---
export const prerender = true;
import { Image } from 'astro:assets';

import iconPanaderia from '@/assets/img/icon-panaderia.png';
import iconReposteria from '@/assets/img/icon-reposteria.png';
import iconHeladeria from '@/assets/img/icon-heladeria.png';
import iconConfiteria from '@/assets/img/icon-confiteria.png';
import iconPasteleria from '@/assets/img/icon-pasteleria.png';

import {APP_PAGES} from '../../core/pages'
---

<div data-animate class="anim-hidden from-top text-center py-8 px-6 mb-28">
    <h1 class="titulos">Cursos disponibles</h1>
    <h3 class="subtitulos text-[#6A6969]">
        Talleres, Seminarios, Formación profesional, Carreras técnicas. <br/>
        En Inforcap encontras todo para una formación integral que te harán
        crecer profesionalmente.
    </h3>
</div>

<div class="w-full md:container mx-auto grid grid-cols-1 md:grid-cols-5 md:max-w-7xl items-center place-content-center gap-4 px-8 mb-48">

    <a data-animate href=`${APP_PAGES.carrera_tecnica_panaderia_y_confiteria}` class="anim-hidden from-bottom w-48 md:w-56 mx-auto hover:scale-110 transition-transform duration-300">
        <Image src={iconPanaderia} alt="Icono Panadería" />
    </a>

    <a data-animate href=`${APP_PAGES.especializacion_pasteleria_y_confiteria}` class="anim-hidden from-bottom delay-100 w-48 md:w-56 mx-auto hover:scale-110 transition-transform duration-300">
        <Image src={iconReposteria} alt="Icono Repostería" />
    </a>

    <a data-animate href={APP_PAGES.especializacion_pasteleria_y_confiteria} class="anim-hidden from-bottom delay-200 w-48 md:w-56 mx-auto hover:scale-110 transition-transform duration-300">
        <Image src={iconHeladeria} alt="Icono Heladería" />
    </a>

    <a data-animate href={APP_PAGES.carrera_tecnica_panaderia_y_confiteria} class="anim-hidden from-bottom delay-300 w-48 md:w-56 mx-auto hover:scale-110 transition-transform duration-300">
        <Image src={iconConfiteria} alt="Icono Confitería" />
    </a>

    <a data-animate href={APP_PAGES.especializacion_decoracion_de_tortas} class="anim-hidden from-bottom delay-400 w-48 md:w-56 mx-auto hover:scale-110 transition-transform duration-300">
        <Image src={iconPasteleria} alt="Icono Pastelería" />
    </a>

</div>
