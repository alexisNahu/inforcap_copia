---
import { Image } from 'astro:assets';
import type { Taller } from '../models';

interface Props {
    taller: Taller;
    verMasHref: string;
}

const { taller, verMasHref } = Astro.props;
---

<div data-animation class="anim-hidden from-top w-4/5 md:w-full h-full flex flex-col justify-between rounded-lg mx-auto overflow-hidden drop-shadow-md bg-white">

    <div class="w-full">
        <Image
                src={taller.imagen_portada}
                alt={taller.titulo}
                width={400}
                height={300}
                class="w-full h-auto object-cover"
        />
    </div>

    <div class="font-petrona px-4 mt-4">
        <div class="text-base uppercase text-grisClaro font-body tracking-tight">TALLER</div>
        <div class="text-3xl leading-tight h-20 overflow-hidden">{taller.titulo}</div>
        <div class="text-2xl text-naranjaInforcap mt-2">Gs. {taller.precio}</div>
    </div>

    <div class="px-4 py-4 space-y-1">
        <div class="text-base text-gris flex items-center">
            <i class="fa-solid fa-arrow-right text-grisClaro mr-2 w-5"></i>
            {taller.dias}
        </div>
        <div class="text-base text-gris flex items-center">
            <i class="fa-solid fa-calendar-days text-grisClaro mr-2 w-5"></i>
            {taller.fecha_inicio}
        </div>
        <div class="text-base text-gris flex items-center">
            <i class="fa-solid fa-clock text-grisClaro mr-2 w-5"></i>
            {taller.horario}
        </div>

        <div class="underline mt-4 text-naranjaInforcap flex items-center gap-2">
            <i class="fa-solid fa-arrow-right"></i>
            <a href={verMasHref} class="font-bold">Ver más</a>
        </div>
    </div>

    <a
            href={`https://wa.me/595983350062?text=Me%20interesa%20el%20Taller%20${encodeURIComponent(taller.titulo)}`}
            target="_blank"
            class="bg-naranjaInforcap w-full py-4 uppercase hover:bg-amarilloInforcap text-white flex justify-center items-center gap-3 transition-colors font-bold"
    >
        <i class="fa-brands fa-whatsapp text-xl"></i>
        INSCRIBIRSE
    </a>
</div>
