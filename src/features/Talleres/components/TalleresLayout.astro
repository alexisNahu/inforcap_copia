---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import {type Taller} from "../models";

interface Props {
    taller: Taller;
    subtitulo?: string;
    duracion?: string;
    mes?: string;
}

const {
    taller,
    subtitulo = "Taller",
    duracion = "3 días",
    mes = "Noviembre"
} = Astro.props;

const { titulo, dias, fecha_inicio, horario, imagen_portada, precio, aprenderas_html } = taller;
---

<Layout title={`${titulo} | Inforcap`}>
    <div class="w-full mt-10 p-4">
        <div class="max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-12 mx-auto">

            <div class="w-full aspect-square overflow-hidden rounded-xl shadow-lg bg-gray-50">
                <Image
                        src={imagen_portada}
                        alt={titulo}
                        width={800}
                        height={800}
                        class="w-full h-full object-cover"
                        loading="eager"
                />
            </div>

            <div class="w-full">
                <header>
                    <h2 class="text-base">{subtitulo}</h2>
                    <h1 class="font-petrona text-4xl md:text-5xl text-bordoInforcap uppercase">{titulo}</h1>
                </header>

                <div class="flex flex-nowrap overflow-x-auto md:overflow-x-visible gap-0 border-y border-gray-100 md:flex my-10 scrollbar-hide">
                    { [
                        { label: 'Mes', val: mes },
                        { label: 'Día', val: dias },
                        { label: 'Fecha', val: fecha_inicio },
                        { label: 'Hora', val: horario }
                    ].map((item) => (
                            <div class="px-6 border-r-2 border-amarilloInforcap">
                                <p class="text-base text-gris">{item.label}</p>
                                <p class="text-2xl md:text-xl font-petrona text-bordoInforcap whitespace-nowrap">{item.val}</p>
                            </div>
                    ))}
                </div>

                <div class="prose prose-slate max-w-none">
                    <p class="text-2xl mb-6 text-bordoInforcap font-bold">
                        Aprenderás a elaborar:
                    </p>

                    <div class="text-base text-gris leading-relaxed mb-8 api-content">
                        {aprenderas_html ? (
                                <div class="list-container" set:html={aprenderas_html} />
                        ) : (
                                <p class="italic text-grisClaro">El temario detallado estará disponible próximamente.</p>
                        )}
                    </div>
                </div>

                <div class="mt-6">
                    <p class="text-base"><strong>Duración:</strong> {duracion}</p>

                    <p class="mt-8 text-2xl font-bold text-bordoInforcap"><span class="bg-naranjaInforcap text-white px-4 py-2 rounded-lg">Inversion: Gs. {precio}</span></p>

                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto bg-amarilloInforcap h-auto drop-shadow-xl mt-20 grid grid-cols-1 md:grid-cols-2 rounded-lg pb-10">

            <div class="w-full rounded-l-lg overflow-hidden">
                <h1 class="text-4xl p-10 font-bold text-bordoInforcap">¡No pierdas esta oportunidad! Elige tu carrera, elige un futuro mejor.</h1>
                <Image
                        src="https://images.pexels.com/photos/15587528/pexels-photo-15587528/free-photo-of-comida-azucar-postre-dulce.jpeg"
                        width={800}
                        height={1200}
                        class="absolute inset-0 -z-10 h-full w-full object-cover object-right md:object-center"
                        alt="Postre dulce"
                />
            </div>

        </div>
    </div>


</Layout>

