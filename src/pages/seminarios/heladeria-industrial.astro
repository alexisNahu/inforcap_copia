---
import imgHeladeria from "@/assets/img/Heladeria-Industrial.jpg";
import SeminarioLayout from "../../components/Seminarios/components/SeminarioLayout.astro";
---

<SeminarioLayout
        titulo='SEMINARIO DE "HELADERIA INDUSTRIAL"'
        subtitulo="Seminario"
        imgSrc={imgHeladeria}
        precio="430.000"
        mes="Agosto"
        dia="Sábados"
        fechas="09 - 23 - 30"
        hora="08:00 a 12:00"
        duracion="3 días"
>
    <ul class="space-y-3">
        <li class="flex gap-2"><span>&rarr;</span> FORMULACIÓN Y ELABORACIÓN DE HELADOS ARTESANALES (AMERICANA, CHOCOLATE, VAINILLA, COCO)</li>
        <li class="flex gap-2"><span>&rarr;</span> ELABORACIÓN DE CUCURUCHOS, PIONONOS Y TULIPAS.</li>
        <li class="flex gap-2"><span>&rarr;</span> ELABORACIÓN DE TORTAS HELADAS Y POSTRES HELADOS.</li>
        <li class="flex gap-2"><span>&rarr;</span> CÁLCULO DE COSTO.</li>
    </ul>
</SeminarioLayout>
