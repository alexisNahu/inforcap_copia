---
import imgAbc from "@/assets/img/ABC-de-la-reposteria.jpg";
import SeminarioLayout from "../../components/Seminarios/components/SeminarioLayout.astro";
---

<SeminarioLayout
        titulo='SEMINARIO "ABC DE LA REPOSTERÍA"'
        subtitulo="Seminario"
        imgSrc={imgAbc}
        precio="430.000"
        mes="Agosto"
        dia="Sábados"
        fechas="09 - 23 - 30"
        hora="08:00 a 12:00"
        duracion="3 días"
>
    <ul class="space-y-3">
        <li class="flex gap-2">
            <span>&rarr;</span>
            ELABORACIÓN DE BIZCOCHUELO EN PLANCHA, ARMADO, BATIDO, RELLENO, PRÁCTICA MANGA Y DECORACIÓN.
        </li>
        <li class="flex gap-2">
            <span>&rarr;</span>
            ELABORACIÓN DE TORTAS FORRADAS A BASE DE PASTA AMERICANA - DISEÑOS VARIOS - PRESENTACIÓN.
        </li>
        <li class="flex gap-2">
            <span>&rarr;</span>
            ELABORACIÓN Y PRESENTACIÓN DE MINI TORTAS PARA EVENTOS A BASE DE BUTTERCREAM.
        </li>
        <li class="flex gap-2">
            <span>&rarr;</span>
            CÁLCULO DE COSTO.
        </li>
    </ul>
</SeminarioLayout>
