---
import {type Seminario} from "../../features/Seminarios/models";
import {SeminarioService} from "../../features/Seminarios/services";
import SeminarioLayout from "../../features/Seminarios/components/SeminarioLayout.astro";

export async function getStaticPaths() {
    const seminarios = await SeminarioService.getAll();

    return seminarios.map((semi: Seminario) => ({
        params: { slug: semi.slug }, // Suponiendo que tu API ya devuelve el campo slug
    }));
}

const { slug } = Astro.params;

const seminario = await SeminarioService.getByIdOrSlug(slug!);

if (!seminario) return Astro.redirect('/404');

---

<SeminarioLayout seminario={seminario}/>

