---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { APP_PAGES } from '../../constants';

import imgPanaderia from '../../assets/img/panaderia-y-confiteria.jpg';
import imgPasteleria from '../../assets/img/pasteleria-y-confiteria.jpg';
import imgDecoracion from '../../assets/img/decoracion-de-tortas-02.jpg';
import imgSeminarios from '../../assets/img/seminarios.jpeg';
import imgMagistrales from '../../assets/img/clases-magistrales-inforcap.jpeg';
import imgEmpresariales from '../../assets/img/capacitacion-13.jpg';

const cursosGrid = [
    {
        title: "Panadería y Confitería",
        img: imgPanaderia,
        href: APP_PAGES.carrera_tecnica_panaderia_y_confiteria
    },
    {
        title: "Pastelería y Confitería",
        img: imgPasteleria,
        href: APP_PAGES.diplomado_pasteleria_y_confiteria
    },
    {
        title: "Diplomado en Repostería y Decoración",
        img: imgDecoracion,
        href: APP_PAGES.diplomado_reposteria_y_decoracion
    },
    {
        title: "Talleres y Seminarios",
        img: imgSeminarios,
        href: "#"
    },
    {
        title: "Clases Magistrales",
        img: imgMagistrales,
        href: APP_PAGES.clases_magistrales
    },
    {
        title: "Capacitaciones empresariales y grupales",
        img: imgEmpresariales,
        href: APP_PAGES.capacitacion_personalizada
    }
];
---

<Layout title="Formación Profesional | Inforcap">

    <section
            data-animate
            class="anim-hidden from-top w-full bg-slate-50"
    >
        <div class="max-w-7xl text-center py-12 px-8 mx-auto">
            <h1 class="text-4xl font-bold tracking-tight font-petrona mb-6 text-bordoInforcap">
                Formación Profesional
            </h1>
            <h3 class="text-lg leading-relaxed text-gris max-w-4xl mx-auto mb-8">
                Las organizaciones hoy en día buscan la constante capacitación para sus empleados...
                Hemos pensado en capacitaciones personalizadas con el objetivo de ayudar a la
                formación de personas interesadas en el crecimiento profesional.
            </h3>
        </div>
    </section>

    <section class="max-w-7xl grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 mx-8 md:mx-auto">
        {cursosGrid.map((curso) => (
                <a
                        href={curso.href}
                        data-animate
                        class="anim-hidden from-bottom group relative h-80 cursor-pointer rounded-2xl overflow-hidden shadow-lg transition-all duration-500 hover:shadow-2xl"
                >
                    <div class="w-full h-full">
                        <Image
                                src={curso.img}
                                alt={curso.title}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        />
                    </div>

                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-500"></div>

                    <div class="absolute inset-0 flex flex-col items-center justify-end pb-10 px-6 text-center transition-all duration-500 group-hover:translate-y-[-10px]">
                        <h2 class="text-2xl font-bold text-white leading-tight">{curso.title}</h2>
                    </div>
                </a>
        ))}
    </section>

</Layout>
