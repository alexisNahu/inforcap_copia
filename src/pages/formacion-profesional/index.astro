---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { APP_PAGES } from '../../constants';

import imgPanaderia from '../../assets/img/panaderia-y-confiteria.jpg';
import imgPasteleria from '../../assets/img/pasteleria-y-confiteria.jpg';
import imgDecoracion from '../../assets/img/decoracion-de-tortas-02.jpg';
import imgSeminarios from '../../assets/img/seminarios.jpeg';
import imgMagistrales from '../../assets/img/clases-magistrales-inforcap.jpeg';
import imgEmpresariales from '../../assets/img/capacitacion-13.jpg';

const cursosGrid = [
    {
        title: "Panadería y Confitería",
        img: imgPanaderia,
        href: APP_PAGES.carrera_tecnica_panaderia_y_confiteria
    },
    {
        title: "Pastelería y Confitería",
        img: imgPasteleria,
        href: APP_PAGES.diplomado_pasteleria_y_confiteria
    },
    {
        title: "Diplomado en Repostería y Decoración",
        img: imgDecoracion,
        href: APP_PAGES.diplomado_reposteria_y_decoracion
    },
    {
        title: "Talleres y Seminarios",
        img: imgSeminarios,
        href: "#"
    },
    {
        title: "Clases Magistrales",
        img: imgMagistrales,
        href: APP_PAGES.clases_magistrales
    },
    {
        title: "Capacitaciones empresariales y grupales",
        img: imgEmpresariales,
        href: APP_PAGES.capacitacion_personalizada
    }
];
---

<Layout title="Formación Profesional | Inforcap">

    <section class="w-full bg-slate-50">
        <div class="max-w-7xl text-center py-16 px-8 mx-auto">
            <h1 class="text-4xl font-bold tracking-tight font-petrona mb-6 text-bordoInforcap">
                Formación Profesional
            </h1>
            <p class="text-lg tracking-tight text-gris max-w-4xl mx-auto leading-relaxed">
                Las organizaciones hoy en día buscan la constante capacitación para sus empleados.
                Hemos diseñado capacitaciones personalizadas con el objetivo de ayudar a la formación
                de grupos interesados en el crecimiento profesional y el desarrollo de vida.
            </p>
        </div>
    </section>

    <section class="max-w-7xl mx-auto py-12 px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {cursosGrid.map((curso) => (
                    <a
                            href={curso.href}
                            class="group relative h-80 cursor-pointer rounded-2xl overflow-hidden shadow-lg transition-all duration-500 hover:shadow-2xl"
                    >
                        <div class="absolute inset-0 w-full h-full">
                            <Image
                                    src={curso.img}
                                    alt={curso.title}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                        </div>

                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent group-hover:from-bordoInforcap/80 transition-colors duration-500"></div>

                        <div class="absolute inset-0 flex flex-col items-center justify-end p-8 text-center transition-all duration-500 transform translate-y-4 group-hover:translate-y-0">
                            <h2 class="text-2xl font-bold text-white mb-2">{curso.title}</h2>
                            <span class="text-amarilloInforcap font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                            Ver información →
                        </span>
                        </div>
                    </a>
            ))}
        </div>
    </section>

</Layout>
