---
import Layout from '../../core/layouts/Layout.astro';
import { Image } from 'astro:assets';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/magistrales-*.{jpeg,jpg,png}');
const imagePaths = Object.values(images);
---

<Layout title="Clases Magistrales | Inforcap">

    <section
            data-animate
            class="anim-hidden from-bottom w-full bg-slate-50 py-12 px-6"
    >
        <div class="max-w-7xl mx-auto">
            <p class="text-bordoInforcap font-bold uppercase tracking-widest text-sm mb-2">
                Clases Magistrales
            </p>
            <h1 class="text-3xl md:text-4xl font-bold font-petrona text-bordoInforcap mb-6">
                Dictadas por invitados especiales como:
            </h1>

            <div class="bg-white p-6 rounded-xl border-l-4 border-amarilloInforcap shadow-sm mb-12">
                <p class="text-xl text-gris italic">
                    <strong class="text-bordoInforcap">Profesor José D'Alonzo:</strong>
                    Maestro Pastelero y Heladero de la Escuela Profesional de Pastelería de Buenos Aires - Argentina.
                </p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {imagePaths.map((img) => (
                        <div class="overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300">
                            <Image
                                    src={img()}
                                    alt="Registro de Clase Magistral Inforcap"
                                    class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500 object-top"
                                    width={400}
                                    height={400}
                                    format="webp"
                            />
                        </div>
                ))}
            </div>
        </div>
    </section>

</Layout>
