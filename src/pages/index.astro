---
export const prerender = false; // Puede seguir siendo true

import { ContenidosServices } from "../features/Contenidos/services";
import Layout from "../core/layouts/Layout.astro";
import Banner from "@/features/Banners/Banner.astro"; // Asumiendo que ahora es React
import Cursos from "../features/Cursos/Cursos.astro";
import Contenido from "@/features/Contenidos/Contenido.astro";
import { type ContenidosMix } from "../features/Contenidos/models";

const contenidos: ContenidosMix = await ContenidosServices.getMix()
---

<Layout title="Inforcap | Inicio">
	<!-- ✅ React se hidrata en el cliente -->
	<Banner />

	<!-- ✅ Estos son Astro (sin JS en cliente) -->
	{contenidos.seminarios && <Contenido info={contenidos.seminarios} />}
	{contenidos.talleres && <Contenido info={contenidos.talleres} bg_color="F3F3F3" />}

	<!-- ✅ Este es Astro -->
	<Cursos />
</Layout>
