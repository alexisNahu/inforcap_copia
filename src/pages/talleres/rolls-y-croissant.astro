---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgRolls from '@/assets/img/rolls.jpg';

const temarioRolls = [
    "ELABORACIÓN DE ROLLS DE CANELA Y CAFÉ",
    "TÉCNICAS DE CROISSANT DE COLORES",
    "RELLENOS VARIOS: DULCES Y SALADOS",
    "TÉCNICA DE LAMINADO Y FERMENTACIÓN",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Especial Rolls & Croissant" | Inforcap'>
    <TalleresLayout
            title='TALLER "ESPECIAL <br/> ROLLS & CROISSANT"'
            image={imgRolls}
            imageAlt="Variedad de Rolls de Canela y Croissants"
            mes="Noviembre"
            dia="Miércoles"
            fecha="05/11/2025"
            hora="14:00 a 18:00"
            temario={temarioRolls}
            costo="Gs. 175.000"
            nota="Duración: 1 día"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Elige tu carrera, elige un futuro mejor.</span>"
    />
</Layout>
