---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgPanesNav from '@/assets/img/panes-navidenos.jpg';

const temarioNavideno = [
    "ELABORACIÓN DE STOLLEN Y ROSCAS NAVIDEÑAS",
    "PAN DULCE CLÁSICO Y CON CHIPS DE CHOCOLATE",
    "VARIEDAD DE BUDINES FESTIVOS",
    "TÉCNICAS DE FERMENTACIÓN Y DECORADO",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Especial Panes Navideños" | Inforcap'>
    <TalleresLayout
            title='Taller "Especial <br/> Panes Navideños"'
            image={imgPanesNav}
            imageAlt="Variedad de Panes Navideños Artesanales"
            mes="Noviembre"
            dia="Sábado"
            fecha="15/11/2025"
            hora="14:00 a 18:00"
            temario={temarioNavideno}
            costo="Gs. 175.000"
            nota="¡Prepara las fiestas con nosotros!"
            fraseGancho="¡Impulsa tus ventas navideñas! <br/> <span class='text-3xl md:text-4xl font-normal'>Aprende los clásicos que todos buscan.</span>"
    />
</Layout>
