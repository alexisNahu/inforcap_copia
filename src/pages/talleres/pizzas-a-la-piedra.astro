---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgPizzas from '@/assets/img/pizzas-a-la-Piedra.jpg';

const temarioPizzas = [
    "MASAS PRE-FERMENTADAS PARA PIZZA A LA PIEDRA",
    "SABORES CLÁSICOS: NAPOLITANA, MUZZARELLA Y PEPPERONI",
    "VARIEDADES GOURMET: FUGAZZETA, PANCETA Y CHOCLO",
    "ELABORACIÓN DE CALZONE NAPOLITANO",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Pizzas a la Piedra y Calzone" | Inforcap'>
    <TalleresLayout
            title='TALLER "PIZZAS A LA PIEDRA <br/> Y CALZONE"'
            image={imgPizzas}
            imageAlt="Pizzas artesanales a la piedra"
            mes="Noviembre"
            dia="Sábado"
            fecha="29/11/2025"
            hora="14:00 a 18:00"
            temario={temarioPizzas}
            costo="Gs. 175.000"
            nota="Duración: 1 día"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Elige tu carrera, elige un futuro mejor.</span>"
    />
</Layout>
