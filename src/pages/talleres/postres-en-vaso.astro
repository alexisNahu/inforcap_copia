---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgPostresVaso from '@/assets/img/postres-vaso.jpg';

const temarioPostres = [
    "POSTRE BROWNIE ARTESANAL",
    "SELVA NEGRA EN FORMATO INDIVIDUAL",
    "RED VELVET: TEXTURAS Y ARMADO",
    "TÉCNICAS DE MONTAJE Y PRESENTACIÓN",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Postres en Vaso" | Inforcap'>
    <TalleresLayout
            title='TALLER "POSTRES <br/> EN VASO"'
            image={imgPostresVaso}
            imageAlt="Variedad de postres en vaso gourmet"
            mes="Noviembre"
            dia="Sábado"
            fecha="29/11/2025"
            hora="08:00 a 12:00"
            temario={temarioPostres}
            costo="Gs. 175.000"
            nota="Duración: 1 día"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Elige tu carrera, elige un futuro mejor.</span>"
    />
</Layout>
