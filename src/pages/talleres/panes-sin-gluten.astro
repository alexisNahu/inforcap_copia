---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgSinGluten from '@/assets/img/panes-sin-gluten.jpg';

const temarioSinGluten = [
    "ELABORACIÓN DE PREPIZZAS SIN TACC",
    "PANES CON HARINA DE SORGO Y ARROZ",
    "USO DE FÉCULAS (MAÍZ Y MANDIOCA)",
    "ANEXO: PAN CHIP TRADICIONAL",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Panes Sin Gluten" | Inforcap'>
    <TalleresLayout
            title='Taller <br/> Panes Sin Gluten'
            image={imgSinGluten}
            imageAlt="Variedad de Panes Sin Gluten y Sin TACC"
            mes="Noviembre"
            dia="Sábado"
            fecha="29/11/2025"
            hora="08:00 a 12:00"
            temario={temarioSinGluten}
            costo="Gs. 175.000"
            nota="¡Opciones saludables y deliciosas!"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Amplía tu emprendimiento con productos inclusivos.</span>"
    />
</Layout>
