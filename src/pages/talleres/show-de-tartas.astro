---
import Layout from '@/layouts/Layout.astro';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";
import imgTartas from '@/assets/img/tartas.jpg';

const temarioTartas = [
    "MASA DE ARENA PARA TARTAS SALADAS",
    "RELLENOS: JAMÓN Y QUESO, CHOCLO Y SICILIANA",
    "ESPECIALIDADES: QUESO AZUL Y POLLO CON CATUPIRY",
    "TÉCNICAS DE COCCIÓN Y CONSERVACIÓN",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Show de Tartas" | Inforcap'>
    <TalleresLayout
            title='TALLER <br/> "SHOW DE TARTAS"'
            image={imgTartas}
            imageAlt="Variedad de tartas saladas artesanales"
            mes="Noviembre"
            dia="Miércoles"
            fecha="12/11/2025"
            hora="14:00 a 18:00"
            temario={temarioTartas}
            costo="Gs. 175.000"
            nota="Duración: 1 día"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Elige tu carrera, elige un futuro mejor.</span>"
    />
</Layout>
