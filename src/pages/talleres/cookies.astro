---
import Layout from '@/layouts/Layout.astro';
import imgCookies from '@/assets/img/cookies.jpg';
import TalleresLayout from "@/components/Talleres/components/TalleresLayout.astro";

const temario = [
    "ELABORACIÓN DE COOKIES SURTIDAS",
    "VARIEDADES: RED VELVET, CHOCOLATE, CAFÉ Y VAINILLA",
    "TÉCNICAS DE RELLENOS DE FRUTAS",
    "CREMAS Y TOPPINGS CREATIVOS",
    "CÁLCULO DE COSTO Y PRECIO DE VENTA"
];
---

<Layout title='Taller "Cookies": Combinación, Texturas y Sabores | Inforcap'>
    <TalleresLayout
            title='TALLER "COOKIES" <br/> COMBINACIÓN, TEXTURAS Y SABORES'
            image={imgCookies}
            imageAlt="Taller de Cookies Surtidas"
            mes="Noviembre"
            dia="Sábado"
            fecha="01/11/2025"
            hora="08:00 a 12:00"
            temario={temario}
            costo="Gs. 175.000"
            nota="Incluye todos los materiales"
            fraseGancho="¡No pierdas esta oportunidad! <br/> <span class='text-3xl md:text-4xl font-normal'>Elige tu carrera, elige un futuro mejor.</span>"
    />
</Layout>
