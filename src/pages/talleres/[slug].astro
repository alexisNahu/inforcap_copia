---
import { TallerService } from "../../features/Talleres/services";
import type { Taller } from "../../features/Talleres/models";
import TalleresLayout from "../../features/Talleres/components/TalleresLayout.astro";

export async function getStaticPaths() {
    const talleres = await TallerService.getAll();

    return talleres.map((taller: Taller) => ({
        params: { slug: taller.slug },
    }));
}

// 2. Obtenemos el slug de la URL
const { slug } = Astro.params;

const taller = await TallerService.getByIdOrSlug(slug!);

if (!taller) return Astro.redirect('/404');
---

<TalleresLayout
        taller={taller}
        subtitulo="Taller de un día"
        duracion={taller.duracion || "1 día"}
        mes="Noviembre"
/>
