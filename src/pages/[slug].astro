---
export const prerender = false;

import { ContenidosServices } from "../features/Contenidos/services";
import ContenidosLayout from "../core/layouts/ContenidosLayout.astro";

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect('/404');
}

// Obtener todos los contenidos (se ejecuta en cada request)
const contenidos = await ContenidosServices.getMix();
const todosLosContenidos = [
    ...(contenidos?.talleres?.content || []),
    ...(contenidos?.seminarios?.content || [])
];

const data = todosLosContenidos.find(item => item.slug === slug);

if (!data) {
    return Astro.redirect('/404');
}
---

<ContenidosLayout data={data} />
