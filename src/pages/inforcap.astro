---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import imgHistoria from '../assets/img/historia-de-inforcap_02.jpg';
import imgCap10 from '../assets/img/capacitacion-10.jpg';
import imgCap11 from '../assets/img/capacitacion-11.jpg';
import imgCap13 from '../assets/img/capacitacion-13.jpg';
import imgEquipo from '../assets/img/equipo-de-profesores.jpg';

const galeriaInstitucional = [imgCap10, imgCap11, imgCap13, imgEquipo];
---

<Layout title="Historia de Inforcap | Excelencia en Gastronomía">

    <section class="w-full bg-slate-50">
        <div class="max-w-7xl py-12 px-8 mx-auto">
            <h1 class="text-4xl font-bold tracking-tight font-petrona mb-12 text-bordoInforcap">Historia de Inforcap</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="overflow-hidden rounded-xl shadow-lg">
                    <Image src={imgHistoria} alt="Inicios de Inforcap" class="w-full h-full object-cover" />
                </div>

                <div class="space-y-6 text-lg leading-relaxed text-gris">
                    <p>
                        <span class="font-bold text-bordoInforcap">INFORCAP</span> inicia sus actividades académicas el 18 de octubre del año 2001 en los campos de Panadería, Confitería, Repostería y Heladería. El Plantel conformado por profesionales especialistas en distintas áreas, sumado a los equipamientos e infraestructura adecuados para el óptimo aprendizaje, marcan hoy la razón de nuestro éxito.
                    </p>
                    <p>
                        A partir de marzo del año 2002, desarrollamos carreras técnicas profesionales y programas de capacitación continua, con el objetivo de formar recursos humanos altamente competitivos basados en la ética, credibilidad y compromiso.
                    </p>
                    <p>
                        Enfatizamos el método científico y la investigación como base del aprendizaje. Estimulamos la creatividad como motor del progreso, porque entendemos que la calidad no es casualidad, sino el resultado de la educación y el liderazgo.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto py-20 px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-amarilloInforcap p-10 rounded-2xl shadow-lg transform hover:-translate-y-2 transition-transform">
                <h2 class="font-bold text-3xl mb-6 text-bordoInforcap">Visión</h2>
                <p class="text-bordoInforcap/90 leading-relaxed">Ser un Instituto sustentado por la comunidad educativa en constante proceso por su calidad y capacidad innovadora, proporcionando el encuentro entre el arte, nutrición y cultura.</p>
            </div>

            <div class="bg-naranjaInforcap p-10 rounded-2xl shadow-lg text-white transform hover:-translate-y-2 transition-transform">
                <h2 class="font-bold text-3xl mb-6">Misión</h2>
                <p class="leading-relaxed">Formar profesionales altamente competitivos y creativos, capaces de destacar y proponer alternativas en el entorno culinario nacional e internacional en constante evolución.</p>
            </div>

            <div class="bg-bordoInforcap p-10 rounded-2xl shadow-lg text-white transform hover:-translate-y-2 transition-transform">
                <h2 class="font-bold text-3xl mb-6">Objetivos</h2>
                <p class="leading-relaxed">Lograr la calificación de mano de obra de calidad para responder al sector industrial y brindar herramientas técnico-profesionales a jóvenes que buscan oportunidades de inserción laboral.</p>
            </div>
        </div>
    </section>

    <section class="w-full bg-bordoInforcap py-16">
        <div class="max-w-4xl mx-auto px-8">
            <div class="rounded-2xl overflow-hidden shadow-2xl">
                <Image src={imgCap10} alt="Capacitación Inforcap" class="w-full h-[480px] object-cover" />
            </div>

            <div class="grid grid-cols-4 gap-4 mt-6">
                {galeriaInstitucional.map((img) => (
                        <div class="rounded-lg overflow-hidden cursor-pointer hover:opacity-80 transition-opacity">
                            <Image src={img} alt="Galería Inforcap" class="h-24 w-full object-cover" />
                        </div>
                ))}
            </div>
        </div>
    </section>

</Layout>
